# FastAPI backend base URL (server-side proxy target for /api/v1/*). Not exposed to the browser.
API_URL=http://localhost:8000

# Supabase project (Settings -> API). The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Use 1x00000000000000000000AA locally (always passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Shows the Google button. Google is configured as a provider inside Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Local development without Supabase: "dev" enables a developer sign-in that mints
# tokens with DEV_AUTH_SECRET (must match the backend). Never use in production.
NEXT_PUBLIC_AUTH_MODE=
DEV_AUTH_SECRET=

# Canonical public URL used in SEO metadata, sitemap.xml, robots.txt and social cards.
NEXT_PUBLIC_SITE_URL=https://findostai.vercel.app
