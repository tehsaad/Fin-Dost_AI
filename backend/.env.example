# ---- FinDost AI backend configuration (copy to .env for local development) ----
# Local: SQLite file. Production: Supabase Postgres connection string
# (Project Settings -> Database -> Connection string -> Transaction pooler, port 6543).
DATABASE_URL=sqlite:///./findost.db

# Supabase project URL - used to verify user access tokens via the project's JWKS.
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret (Settings -> API -> JWT secret).
SUPABASE_JWT_SECRET=
# Local development only: accept HS256 tokens signed with this secret. Never set in production.
DEV_AUTH_SECRET=

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Optional AI providers (both off by default; FinDost works fully without them).
# Groq: explanations / Urdu / Roman Urdu wording of figures FinDost computed. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Gemini: receipt/invoice photo reading, and fallback for explanations. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=12
# Per-workspace daily cap on AI requests (stored in the database, so it holds across serverless instances).
AI_DAILY_LIMIT=60

# Private demo workspaces (visitors who click "Try a private demo" sign in anonymously).
ANON_AI_DAILY_LIMIT=10
ANON_MAX_TRANSACTIONS=3000
DEMO_TTL_DAYS=7
# Shared secret Vercel Cron sends to /api/v1/internal/cleanup-demos (any long random string).
CRON_SECRET=

# Optional: pin "today" (YYYY-MM-DD) for reproducible demos/tests.
FINDOST_TODAY=
MAX_UPLOAD_BYTES=2097152
ENVIRONMENT=development
